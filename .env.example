GROQ_API_KEY=your_groq_api_key_here

# Optional. Overrides the default Groq model (openai/gpt-oss-20b). Groq's
# catalog of available models changes over time and varies by account — if
# generation fails with a 404 "model_not_found" error, check
# console.groq.com/docs/models (or client.models.list()) for a model your
# account can access and set it here.
GROQ_MODEL=openai/gpt-oss-20b
